# Copy to .env and fill in ONE of the two auth paths. Never commit .env.

# --- Path A: direct Anthropic API (simplest; use this to get the first call working) ---
ANTHROPIC_API_KEY=

# --- Path B: Claude via Amazon Bedrock (the target deployment path) ---
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=us-east-1
# AWS_PROFILE=            # or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or AWS_BEARER_TOKEN_BEDROCK
# ANTHROPIC_MODEL=        # Bedrock model ID, e.g. us.anthropic.claude-opus-5-v1:0 (verify in your Bedrock console)

# --- Optional tunables (defaults shown) ---
# BLUEPRINT_MODEL=claude-opus-5             # discovery conversation model
# BLUEPRINT_CLASSIFIER_MODEL=claude-opus-5  # department classifier (benchmarked; see evals/)
# BLUEPRINT_MAX_BUDGET_USD=3.0              # hard spend cap per discovery session
# BLUEPRINT_IDLE_TIMEOUT_S=90               # seconds with no model output before a turn is abandoned

# --- Optional web search (regulatory grounding only; off by default, always off in evals) ---
# BLUEPRINT_WEB_SEARCH=0
# TAVILY_API_KEY=
