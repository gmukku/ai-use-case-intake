# Copy to .env and fill in ONE of the three auth paths. Never commit .env.

# --- Path A: direct Anthropic API (simplest; use this to get the first call working) ---
ANTHROPIC_API_KEY=

# --- Path B: Claude via Amazon Bedrock (the target deployment path) ---
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=us-east-1
# AWS_PROFILE=            # or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or AWS_BEARER_TOKEN_BEDROCK
# ANTHROPIC_MODEL=        # Bedrock model ID, e.g. us.anthropic.claude-opus-5-v1:0 (verify in your Bedrock console)

# --- Path C: Claude via Google Vertex AI ---
# CLAUDE_CODE_USE_VERTEX=1
# ANTHROPIC_VERTEX_PROJECT_ID=my-gcp-project
# CLOUD_ML_REGION=us-east5    # or a per-model VERTEX_REGION_CLAUDE_* override instead
# ANTHROPIC_MODEL=            # Vertex model ID (the exact string is in Model Garden)
#
# There is no credential variable here on purpose. Vertex uses Google Application Default
# Credentials: `gcloud auth application-default login` locally, or the attached service
# account on a GCE VM or Cloud Run, where nothing needs to be set at all.
#
# Two things that bite on a fresh project, both before the first call works: enable Claude in
# Vertex Model Garden, and request quota for it — new projects start at zero.

# --- Optional tunables (defaults shown) ---
# BLUEPRINT_MODEL=claude-opus-5             # discovery conversation model
# BLUEPRINT_CLASSIFIER_MODEL=claude-opus-5  # department classifier (benchmarked; see evals/)
# BLUEPRINT_MAX_BUDGET_USD=3.0              # hard spend cap per discovery session
# BLUEPRINT_IDLE_TIMEOUT_S=90               # seconds with no model output before a turn is abandoned
# BLUEPRINT_SOP_GROUNDING=1                 # attach the SOP library (stdio MCP server); local and deterministic
# BLUEPRINT_SOP_DIR=sop_docs                # where the SOP server loads documents from
# BLUEPRINT_COMPLETENESS_CHECK=1            # judge each recorded category against its rubric; ask to fill gaps
# BLUEPRINT_CHECKER_MODEL=claude-opus-5     # model for the completeness checker
# BLUEPRINT_BUILD_BUDGET_USD=1.5            # hard spend cap for one Builder run

# --- Optional web search (regulatory grounding only; off by default, always off in evals) ---
# BLUEPRINT_WEB_SEARCH=0
# TAVILY_API_KEY=

# --- API (step 7) ---
# BLUEPRINT_ADMIN_TOKEN=                    # bearer token for reviewer/admin/build endpoints; unset = open (local dev only)
# BLUEPRINT_SESSION_IDLE_S=900              # close a live session's subprocess after this much inactivity
# BLUEPRINT_CORS_ORIGINS=http://localhost:3000

# --- Storage and audit (step 12) ---
# Unset keeps one JSON file per run under runs/. A path switches to SQLite, which adds the
# append-only audit_events table and makes the run list a query instead of 12 file reads.
# Migrate what you already have:  uv run python cli.py migrate
# BLUEPRINT_STORE_PATH=runs/blueprint.db
# Strip emails, phone numbers, SSNs, card and account numbers from free text on the way into
# the store. On by default; there is no un-redact, the original is never written.
# BLUEPRINT_REDACT=1
# Delete runs not written within this many days. 0 (the default) keeps everything.
# BLUEPRINT_RETENTION_DAYS=0
