# --- Browser-visible (inlined into the JS bundle at build time) ---
# 127.0.0.1 rather than localhost: on Windows localhost may resolve to ::1 while uvicorn
# listens on 127.0.0.1.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Server-only (route handlers). No NEXT_PUBLIC_ prefix, so never sent to the browser. ---
# Where the route handlers reach FastAPI. Usually the same host as above.
BLUEPRINT_API_URL=http://127.0.0.1:8000
# Must match BLUEPRINT_ADMIN_TOKEN in the backend's .env. The reviewer surface proxies
# through this app precisely so the browser never holds it.
BLUEPRINT_ADMIN_TOKEN=
