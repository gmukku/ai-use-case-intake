# secrets — never commit credentials
.env
.env.*
!.env.example

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# local data
*.db
*.sqlite

# node (later, for the Next.js frontend)
node_modules/
.next/

# local run artifacts (hand-test snapshots and logs); promote to fixtures deliberately, not by default
runs/
logs/

# eval run outputs (raw per-call results); summaries get written up, not committed
evals/**/results/

# model-generated prototypes (one folder per session); promote deliberately if worth keeping
prototypes/

# SQLite store + audit trail (holds stakeholder text)
runs/*.db
runs/*.db-wal
runs/*.db-shm

# Local working notes. Kept on disk, never published.
CLAUDE.md
